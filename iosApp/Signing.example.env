# Copy this file to iosApp/Signing.env (it is git-ignored) and fill in your own values,
# then run tools/gen-project.sh paid (or free).

# Your Apple Developer team ID: Xcode → Settings → Accounts, or developer.apple.com → Membership.
MODE_TEAM=ABCDE12345

# An app ID prefix of your own (reverse-DNS). The app is <prefix>, the widgets <prefix>.widgets,
# the VPN extension on paid accounts <prefix>.tunnel.
MODE_BUNDLE_PREFIX=com.yourname.mode
