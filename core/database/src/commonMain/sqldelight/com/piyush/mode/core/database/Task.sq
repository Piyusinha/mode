-- Something the user asked Mode to do, from any source.
CREATE TABLE task (
    id TEXT NOT NULL PRIMARY KEY,
    conversation_id TEXT REFERENCES conversation(id) ON DELETE SET NULL,
    text TEXT NOT NULL,
    source TEXT NOT NULL,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    started_at INTEGER,
    ended_at INTEGER,
    run_id TEXT,
    summary TEXT,
    steps INTEGER,
    cost_usd REAL,
    -- 1: neither uses nor adds to memory.
    private INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX task_status ON task(status, created_at);

insert:
INSERT INTO task(id, conversation_id, text, source, status, created_at, private) VALUES (?, ?, ?, ?, ?, ?, ?);

setStatus:
UPDATE task SET status = ? WHERE id = ?;

start:
UPDATE task SET status = ?, started_at = ?, run_id = ? WHERE id = ?;

finish:
UPDATE task SET status = ?, ended_at = ?, summary = ?, steps = ?, cost_usd = ? WHERE id = ?;

byId:
SELECT * FROM task WHERE id = ?;

recent:
SELECT * FROM task ORDER BY created_at DESC LIMIT ?;

withStatus:
SELECT * FROM task WHERE status = ? ORDER BY created_at;

costSince:
SELECT COALESCE(SUM(cost_usd), 0.0) AS total FROM task WHERE created_at >= ?;

addCost:
UPDATE task SET cost_usd = COALESCE(cost_usd, 0) + ? WHERE id = ?;

queued:
SELECT * FROM task WHERE status = 'queued' ORDER BY created_at, rowid;

interruptRunning:
UPDATE task SET status = 'failed', ended_at = ?, summary = 'Mode was closed during this task.'
WHERE status IN ('running', 'waiting');

expireQueued:
UPDATE task SET status = 'not_started', ended_at = ?, summary = 'Not run: it waited over an hour while Mode was closed.'
WHERE status = 'queued' AND created_at < ?;

deleteAll:
DELETE FROM task;

-- Backup and restore (feature:backup): every row in insertion order, and adding without replacing.
everything:
SELECT * FROM task ORDER BY rowid;

ids:
SELECT id FROM task;

insertOrIgnore:
INSERT OR IGNORE INTO task(id, conversation_id, text, source, status, created_at, started_at, ended_at, run_id, summary, steps, cost_usd, private)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

countAll:
SELECT count(*) FROM task;
