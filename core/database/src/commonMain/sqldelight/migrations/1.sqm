-- Version 1 → 2: what Mode remembers between tasks (docs/harness.md §4).
CREATE TABLE memory (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    subject TEXT NOT NULL,
    title TEXT NOT NULL,
    text TEXT NOT NULL,
    evidence TEXT NOT NULL,
    keywords TEXT NOT NULL DEFAULT '',
    app TEXT,
    source_task_id TEXT,
    previous_text TEXT,
    uses INTEGER NOT NULL DEFAULT 0,
    successes INTEGER NOT NULL DEFAULT 0,
    failures INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    last_used_at INTEGER
);

CREATE INDEX memory_kind_subject ON memory(kind, subject);
CREATE INDEX memory_source_task ON memory(source_task_id);
