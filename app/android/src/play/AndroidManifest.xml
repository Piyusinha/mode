<?xml version="1.0" encoding="utf-8"?>
<!-- The Play build: nothing that drives the phone. No accessibility service (only the full build declares it),
     no special-use working service, no background mode. Chat, voice, memory and repeats work as usual. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
    <application>
        <service android:name="com.piyush.mode.core.platform.WorkService" tools:node="remove" />
    </application>
</manifest>
