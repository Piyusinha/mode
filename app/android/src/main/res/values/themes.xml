<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No system title bar: Mode draws every screen itself, edge to edge, on its paper page. -->
    <style name="Theme.Mode" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/mode_page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
