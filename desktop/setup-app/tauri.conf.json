{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mode Setup",
  "version": "0.1.0",
  "identifier": "app.mode.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mode Setup",
        "width": 960,
        "height": 640,
        "minWidth": 880,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Piyush Sinha",
    "copyright": "Copyright 2026 Piyush Sinha. Apache License 2.0.",
    "category": "DeveloperTool",
    "shortDescription": "Install Mode on your iPhone and pair it.",
    "longDescription": "Mode Setup signs and installs Mode on your iPhone with your Apple account, turns on phone control, and keeps Mode signed.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "usbmuxd"
        ]
      }
    }
  }
}
