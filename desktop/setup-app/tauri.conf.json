{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mode Setup",
  "version": "0.1.0",
  "identifier": "app.mode.setup",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Mode Setup", "width": 960, "height": 640, "minWidth": 880, "minHeight": 600 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": { "../../build/release/Mode.ipa": "Mode.ipa", "../../build/release/Mode-paid.ipa": "Mode-paid.ipa" }
  }
}
